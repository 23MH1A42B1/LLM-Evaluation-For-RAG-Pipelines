# Environment Configuration for LLM Evaluation Regression Harness
# Copy this file to .env and replace placeholders with real keys when running live evaluations.
# NOTE: Do NOT commit any real keys into source control!

# LLM Provider Configuration
OPENAI_API_KEY=your_openai_api_key_here
LLM_JUDGE_MODEL=gpt-4o-mini-2024-07-18

# Vector Database Configuration (Qdrant / Chroma)
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=6333
VECTOR_DB_URL=http://localhost:6333
VECTOR_COLLECTION_NAME=hotpot_rag_eval

# Embedding Models Pinned in eval_pins.json
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# Evaluation Parameters
EVAL_DATASET_PATH=dataset/eval_set.json
CORPUS_DATASET_PATH=dataset/corpus.json
CONFIG_PINS_PATH=config/eval_pins.json
PROMPTS_CONFIG_PATH=prompts/judge_prompts.json
RESULTS_DIR=results

